{
    "typography": {
    "family": "-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif",
    "sizes": { "sm": 13, "md": 15, "lg": 17, "xl": 22, "xxl": 28 },
    "weights": { "regular": 400, "medium": 500, "semibold": 600, "bold": 700 },
    "letterSpacing": { "tight": -0.01 }
  },
  "spacing": { "2": 8, "3": 12, "4": 16, "5": 20, "6": 24 },
  "radius": { "sm": 10, "md": 14, "lg": 20 },
  "colors": {
    "bg": "#f7f7f9",
    "surface": "#ffffff",
    "muted": "#6b7280",
    "strong": "#111827",
    "primary": "#0a84ff",
    "accent": "#34c759",
    "danger": "#ff3b30",
    "border": "#e5e7eb"
  },
  "shadows": {
    "soft": "0 2px 10px rgba(0,0,0,0.06)",
    "strong": "0 10px 24px rgba(0,0,0,0.12)"
  }
}
